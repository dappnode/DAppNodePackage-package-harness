PORT=8080
DATA_DIR=./.data
HARNESS_DNP_NAME=package-harness.dnp.dappnode.eth
PACKAGE_MANAGER_MODE=fake
# Required acknowledgement that this worker may install, update, and remove packages.
ALLOW_DESTRUCTIVE_PACKAGE_TESTS=true

# Tropibot polling worker. The shared token is suitable for this small trusted
# v1 deployment; a later protocol revision can replace it with per-worker auth.
TROPIBOT_URL=https://tropibot.example
PACKAGE_HARNESS_WORKER_ID=worker-01
PACKAGE_HARNESS_WORKER_TOKEN=replace-with-a-long-random-token
PACKAGE_HARNESS_POLL_SECONDS=10
PACKAGE_HARNESS_HEARTBEAT_SECONDS=20
TROPIBOT_TIMEOUT_MS=15000

# Required when PACKAGE_MANAGER_MODE=mcp
# Enable external MCP mutating tools in Dappmanager System > Advanced.
# Startup verifies the bearer token, all required tools, and read operations.
DAPPMANAGER_MCP_URL=http://my.dappnode/mcp
DAPPMANAGER_MCP_TOKEN=replace-with-dappmanager-bearer-token
MCP_TIMEOUT_MS=30000
# Install, update, and remove operations can wait substantially longer than
# read-only MCP calls. The default is 30 minutes; the maximum is one hour.
MCP_MUTATION_TIMEOUT_MS=1800000
MCP_MUTATION_ATTEMPTS=3
MCP_MUTATION_RETRY_DELAY_MS=5000

STABILIZATION_TIMEOUT_MS=180000
STABILIZATION_POLL_MS=5000
STABILIZATION_REQUIRED_SAMPLES=3
LOG_TAIL=300
CLEANUP_TIMEOUT_MS=60000
# Optional operator-owned JSON profiles with HTTP, TCP, or read-only JSON-RPC probes.
# Example: {"n8n.dnp.dappnode.eth":{"probes":[{"type":"http","name":"api","url":"http://n8n.dappnode:5678/healthz"}]}}
READINESS_PROFILES={}

# Optional advisory analysis
# If configured, startup requires a successful one-token synthetic completion.
NEXUS_API_KEY=
NEXUS_BASE_URL=https://nexus-api.dappnode.com/v1
NEXUS_MODEL=nexus/auto
# Advisory startup-evidence classifier. Empty disables it; failures never block analysis.
NEXUS_CLASSIFIER_MODEL=jev
NEXUS_TIMEOUT_MS=300000
# Per-request JSON input budget. Large captures use multiple complete batches.
NEXUS_MAX_INPUT_BYTES=65536
